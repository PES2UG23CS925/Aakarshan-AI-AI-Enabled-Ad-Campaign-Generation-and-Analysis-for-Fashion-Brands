{
  "name": "akarshan-ai-backend",
  "version": "5.2.0",
  "engines": { "node": ">=18" },
  "description": "AI-powered ad generation and performance analytics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "train": "python ml_artifacts/train.py",
    "test:ml": "python ml_artifacts/test_ml.py",
    "test:api": "node tests/integration.js && node tests/simulate_traffic.test.js && node tests/trends_and_images.test.js && node tests/admin_report.test.js",
    "demo:seed": "node scripts/simulate_demo_traffic.js",
    "evaluate": "python ml_artifacts/evaluate.py"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.44",
    "@supabase/supabase-js": "^2.39.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
