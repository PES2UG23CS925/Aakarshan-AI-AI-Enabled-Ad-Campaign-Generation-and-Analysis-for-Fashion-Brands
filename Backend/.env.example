PORT=5000

# Supabase: Dashboard > Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=change-me-to-a-long-random-string

# Groq: free key from https://console.groq.com
GROQ_API_KEY=your-groq-key

# Pollinations.ai: REQUIRED. Create a free key at https://enter.pollinations.ai/keys (starts with sk_ or pk_)
POLLINATIONS_API_KEY=

# Python used for the ML scripts. Leave blank to auto-detect (python3 on Mac/Linux, python on Windows)
PYTHON_BIN=

# Production only: comma-separated frontend URLs allowed to call this API (unset = localhost dev only)
ALLOWED_ORIGINS=
