PORT=5000

# Supabase — get from https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

JWT_SECRET=replace_with_a_long_random_secret

# Groq — get free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Pollinations.ai image generation - a key is now REQUIRED.
# Create one (free) at https://enter.pollinations.ai/keys and paste it below (starts with sk_ or pk_).
POLLINATIONS_API_KEY=your_pollinations_api_key
# Python used for the ML scripts. Leave blank to auto-detect (python3 on Mac/Linux, python on Windows)
PYTHON_BIN=

# Production only: comma-separated frontend URLs allowed to call this API (unset = localhost dev only)
ALLOWED_ORIGINS=http://localhost:5173
